{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Resources": {
    "ApplicantFilterSystemDev": {
      "Type": "AWS::DynamoDB::Table",
      "Properties": {
        "KeySchema": [
          {
            "AttributeName": "pk",
            "KeyType": "HASH"
          },
          {
            "AttributeName": "sk",
            "KeyType": "RANGE"
          }
        ],
        "AttributeDefinitions": [
          {
            "AttributeName": "pk",
            "AttributeType": "S"
          },
          {
            "AttributeName": "sk",
            "AttributeType": "S"
          }
        ],
        "GlobalSecondaryIndexes": [],
        "BillingMode": "PROVISIONED",
        "TableName": "ApplicantFilterSystemDev",
        "ProvisionedThroughput": {
          "ReadCapacityUnits": 2,
          "WriteCapacityUnits": 2
        }
      }
    },
    "TableApplicantFilterSystemDevReadCapacityScalableTarget": {
      "Type": "AWS::ApplicationAutoScaling::ScalableTarget",
      "DependsOn": "ApplicantFilterSystemDev",
      "Properties": {
        "ServiceNamespace": "dynamodb",
        "ResourceId": "table/ApplicantFilterSystemDev",
        "ScalableDimension": "dynamodb:table:ReadCapacityUnits",
        "MinCapacity": 2,
        "MaxCapacity": 20,
        "RoleARN": {
          "Fn::Sub": "arn:aws:iam::${AWS::AccountId}:role/aws-service-role/dynamodb.application-autoscaling.amazonaws.com/AWSServiceRoleForApplicationAutoScaling_DynamoDBTable"
        }
      }
    },
    "TableApplicantFilterSystemDevReadCapacityScalingPolicy": {
      "Type": "AWS::ApplicationAutoScaling::ScalingPolicy",
      "DependsOn": "TableApplicantFilterSystemDevReadCapacityScalableTarget",
      "Properties": {
        "ServiceNamespace": "dynamodb",
        "ResourceId": "table/ApplicantFilterSystemDev",
        "ScalableDimension": "dynamodb:table:ReadCapacityUnits",
        "PolicyName": "ApplicantFilterSystemDev-read-capacity-scaling-policy",
        "PolicyType": "TargetTrackingScaling",
        "TargetTrackingScalingPolicyConfiguration": {
          "PredefinedMetricSpecification": {
            "PredefinedMetricType": "DynamoDBReadCapacityUtilization"
          },
          "ScaleOutCooldown": 60,
          "ScaleInCooldown": 60,
          "TargetValue": 20
        }
      }
    },
    "TableApplicantFilterSystemDevWriteCapacityScalableTarget": {
      "Type": "AWS::ApplicationAutoScaling::ScalableTarget",
      "DependsOn": "ApplicantFilterSystemDev",
      "Properties": {
        "ServiceNamespace": "dynamodb",
        "ResourceId": "table/ApplicantFilterSystemDev",
        "ScalableDimension": "dynamodb:table:WriteCapacityUnits",
        "MinCapacity": 2,
        "MaxCapacity": 20,
        "RoleARN": {
          "Fn::Sub": "arn:aws:iam::${AWS::AccountId}:role/aws-service-role/dynamodb.application-autoscaling.amazonaws.com/AWSServiceRoleForApplicationAutoScaling_DynamoDBTable"
        }
      }
    },
    "TableApplicantFilterSystemDevWriteCapacityScalingPolicy": {
      "Type": "AWS::ApplicationAutoScaling::ScalingPolicy",
      "DependsOn": "TableApplicantFilterSystemDevWriteCapacityScalableTarget",
      "Properties": {
        "ServiceNamespace": "dynamodb",
        "ResourceId": "table/ApplicantFilterSystemDev",
        "ScalableDimension": "dynamodb:table:WriteCapacityUnits",
        "PolicyName": "ApplicantFilterSystemDev-write-capacity-scaling-policy",
        "PolicyType": "TargetTrackingScaling",
        "TargetTrackingScalingPolicyConfiguration": {
          "PredefinedMetricSpecification": {
            "PredefinedMetricType": "DynamoDBWriteCapacityUtilization"
          },
          "ScaleOutCooldown": 60,
          "ScaleInCooldown": 60,
          "TargetValue": 20
        }
      }
    }
  }
}